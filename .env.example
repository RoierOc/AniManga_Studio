# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# start_server.sh sources this file into the environment.

# Library / model paths (optional — default to data/ and models/ under the repo).
# Leave commented out to use the defaults; uncomment only to point elsewhere.
# MANGA_DIR=
# UPSCALED_DIR=
# MODELS_DIR=

# Flask session secret. If unset, a random per-process key is generated.
# Generate a stable one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MangaDex OAuth (https://mangadex.org → Settings → API Clients)
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=

# TMDB — high-quality anime hero backdrops (free key: themoviedb.org → Settings → API)
# Optional: without it the hero falls back to AniList banners (still high quality).
TMDB_API_KEY=

# Subtitle translation
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5:14b
# TRANSLATION_ENGINE=ollama   # 'ollama' (default, Gemini fallback) or 'gemini' (Ollama fallback)

# Subtitle sources (optional)
JIMAKU_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBDL_API_KEY=

# qBittorrent auto-launch (Anime Studio). Only used if its WebUI (:8080) isn't
# already reachable when start_server.sh runs — the search/download integration
# itself works on any OS as long as the WebUI is up, auto-launch is just a convenience.
# QBT_WIN_PATH=C:\Program Files\qBittorrent\qbittorrent.exe   # Windows/WSL only, if installed elsewhere
# QBT_LAUNCH_CMD=                                              # set to use any other client/launch command, skips OS detection entirely

PYTHONUNBUFFERED=1
