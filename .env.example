# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# start_server.sh sources this file into the environment.

# Library paths (optional — default to /Manga_Upscaler_project/MangaLibrary[_Upscaled])
MANGA_DIR=
UPSCALED_DIR=

# Flask session secret. If unset, a random per-process key is generated.
# Generate a stable one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MangaDex OAuth (https://mangadex.org → Settings → API Clients)
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=
MANGADEX_USERNAME=
MANGADEX_PASSWORD=

# Subtitle translation
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5:14b

# Subtitle sources (optional)
JIMAKU_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
SUBDL_API_KEY=

PYTHONUNBUFFERED=1
