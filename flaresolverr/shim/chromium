#!/usr/bin/env bash
# Shim de Chromium para FlareSolverr en WSLg.
#
# FlareSolverr lanza Chromium con `--single-process`, que es oficialmente inestable y ABORTA
# (SIGABRT en ThreadPoolForeg) bajo el JS pesado del reto de Cloudflare → "invalid session id:
# browser has closed the connection", de forma intermitente, y Prowlarr fallaba con "blocked by
# CloudFlare Protection". La solución NO es sólo quitar --single-process (sin zygote, chrome
# multiproceso sin sandbox no arranca), sino cambiarlo por `--no-zygote`: multiproceso real pero
# forkeando sin el zygote, que es lo que funciona en entornos sin sandbox (contenedores/WSL).
args=()
for a in "$@"; do
  [ "$a" = "--single-process" ] && continue
  args+=("$a")
done
# 🔴 `--no-zygote` SIN `--no-sandbox` no arranca: Chromium 142 sale de inmediato con
# «Zygote cannot be disabled if sandbox is enabled» y FlareSolverr lo reporta como
# «invalid session id: session deleted as the browser has closed the connection» — un mensaje que
# habla de la sesión de Selenium y no dice ni una palabra del motivo real. Se pasó un año dando por
# roto FlareSolverr por esto.
#
# El sandbox aquí no se pierde: corriendo como root en WSL, Chromium ya no puede usarlo. Lo que
# navega es un contenedor de resolver retos, no un navegador de uso general.
args+=(--no-sandbox)

# 🔴 Y el MISMO veneno que ya tenía el shim de `sh`: FlareSolverr va empaquetado con PyInstaller y
# exporta su propio `LD_LIBRARY_PATH`, que Chromium HEREDA. Con las libs equivocadas debajo, la
# resolución de nombres se rompe y la página falla con `net::ERR_INTERNET_DISCONNECTED` — que dice
# «no tienes internet» cuando el internet está perfecto y lo roto es el enlazador.
unset LD_LIBRARY_PATH
exec /usr/sbin/chromium \
  --no-zygote --disable-gpu --disable-dev-shm-usage \
  "${args[@]}"
