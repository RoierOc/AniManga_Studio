{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniManga Studio",
  "version": "0.1.0",
  "identifier": "dev.roier.animanga",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AniManga Studio",
        "url": "splash.html",
        "width": 1500,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#05070d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
