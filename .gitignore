# Python cache artifacts
# Dependencias y resultados de compilacion regenerables
node_modules/
/frontend/dist/
*.bak_ai

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Tooling cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime outputs
*.log

# Windows Zone.Identifier metadata (WSL artifact)
*:Zone.Identifier

# Runtime status JSON files
.*_status.json

# Backup files
*.bak

# Suwayomi runtime data (extensions, database, downloads) — no trailing slash
# so this also matches when it's a symlink to a dir (machine-local convenience),
# not just a real directory.
suwayomi/data
suwayomi/*.jar

# User data (downloaded/upscaled manga) — defaults under the repo, see runtime.py
data/

# Large binary files not belonging to the app
*.onnx
*.onnx.data
*.pth
*.safetensors

# Environment secrets
.env
.env.*
!.env.example
google_credentials.json

# MPV screenshot artifacts
src/mpv-shot*.jpg
mpv-shot*.jpg

# Telemetry / dev-only artifacts
gpu_log.jsonl
.mcp.json

# Old prototypes, not part of the active app
archive/

# README screenshot/gif inbox — unprocessed drops, never committed
docs/img/raw/
hevc_test.mp4

# URLs de modelos para fetch-models.sh (pueden ser privadas)
scripts/model-urls.env

# Artefactos de compilación de Rust (regenerables con cargo build)
desktop/native/target/

# Artefactos de compilación de Rust (regenerables con cargo build)
desktop/native/target/

# Scripts de captura de un solo uso (Playwright) y mockups descartados:
# el mockup ya está implementado, y su arte son portadas reales de la biblioteca
_shots*.mjs
_mark_shot.mjs
docs/dev/mockups/

# Configuración local; GitHub conserva los workflows públicos.
/.*/
!/.github/
/.github/*/
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/

# Documentación pública de raíz; notas de trabajo permanecen locales.
/*.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/LICENSE.md
!/AUTHORS.md
/skills-lock.json
/docs/dev/
/docs/*/
!/docs/img/
