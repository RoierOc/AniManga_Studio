# Python cache artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Tooling cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime outputs
*.log

# Windows Zone.Identifier metadata (WSL artifact)
*:Zone.Identifier

# Runtime status JSON files
.*_status.json

# Backup files
*.bak

# Suwayomi runtime data (extensions, database, downloads) — no trailing slash
# so this also matches when it's a symlink to a dir (machine-local convenience),
# not just a real directory.
suwayomi/data
suwayomi/*.jar

# User data (downloaded/upscaled manga) — defaults under the repo, see runtime.py
data/

# Large binary files not belonging to the app
*.onnx
*.onnx.data
*.pth
*.safetensors

# Environment secrets
.env
google_credentials.json

# MPV screenshot artifacts
src/mpv-shot*.jpg
mpv-shot*.jpg

# Telemetry / dev-only artifacts
gpu_log.jsonl
.mcp.json

# Old prototypes, not part of the active app
archive/

# Local configuration and public repository metadata.
/.*/
!/.github/
/.github/*/
!/.github/workflows/
!/.github/ISSUE_TEMPLATE/
/*.md
!/README.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/LICENSE.md
!/AUTHORS.md
/docs/*/
!/docs/img/
